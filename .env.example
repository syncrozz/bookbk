# Server-side Master Admin Passcode (used by server.ts and src/server/auth-service.ts)
ADMIN_PASSCODE=

# Server-side Firebase Admin SDK Service Account JSON for Staff Custom Token Bridge (used by src/server/auth-service.ts)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional overrides (application provides valid built-in defaults)
# STAFF_VAULT_PATH= (optional; defaults to server/data/staff-credentials-vault.json)
# BOOKBK_BUILD_ID= (optional; auto-generated at build time if unset)