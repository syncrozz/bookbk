{
  "entities": {
    "bookings": {
      "title": "AdHoc Booking",
      "description": "Ad-hoc venue booking records created by users or lecturers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantEmail": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "applicantRole": { "type": "string" },
        "department": { "type": "string" },
        "purposeCategory": { "type": "string" },
        "title": { "type": "string" },
        "paxCount": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["CONFIRMED", "PENDING", "REJECTED", "CANCELLED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomId", "date", "startTime", "endTime", "applicantName", "title", "status"]
    },
    "rooms": {
      "title": "Room Facility",
      "description": "Classrooms, lecture halls, and special rooms in KPMBP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "capacity": { "type": "number" },
        "block": { "type": "string" },
        "level": { "type": "string" },
        "facilities": { "type": "array", "items": { "type": "string" } },
        "hasAircond": { "type": "boolean" },
        "isSmartClassroom": { "type": "boolean" }
      },
      "required": ["id", "code", "name", "category", "capacity"]
    },
    "schedule": {
      "title": "Academic Schedule",
      "description": "Official weekly academic class schedule slots",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "courseCode": { "type": "string" },
        "courseName": { "type": "string" },
        "className": { "type": "string" },
        "lecturerName": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "roomId", "dayOfWeek", "startTime", "endTime"]
    },
    "blocks": {
      "title": "Institutional Block",
      "description": "Official institutional events blocking room availability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "endDate": { "type": "string" },
        "category": { "type": "string", "enum": ["EXAM", "INSTITUTIONAL", "MAINTENANCE"] },
        "batchId": { "type": "string" },
        "title": { "type": "string" },
        "reason": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "roomId", "date", "startTime", "endTime", "title"]
    },
    "staff_users": {
      "title": "Registered Staff Directory",
      "description": "Registered KPMBP staff details from CSV with email and 4-digit Owner PIN",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "department": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "passcode": { "type": "string" },
        "pin": { "type": "string" },
        "pinStatus": { "type": "string", "enum": ["DEFAULT", "CUSTOM"] },
        "pinChangedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "pin"]
    },
    "metadata": {
      "title": "Platform Metadata & Configuration",
      "description": "System metadata including academic schedule exemptions (Study Week) and versioning",
      "type": "object",
      "properties": {
        "academicExemptions": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "startDate": { "type": "string" },
                  "endDate": { "type": "string" },
                  "scope": { "type": "string", "enum": ["ALL_ROOMS", "BILIK_KULIAH", "SELECTED"] },
                  "roomIds": { "type": "array", "items": { "type": "string" } },
                  "reason": { "type": "string" },
                  "active": { "type": "boolean" },
                  "createdBy": { "type": "string" },
                  "createdAt": { "type": "string" }
                },
                "required": ["id", "title", "startDate", "endDate", "scope", "active", "createdBy", "createdAt"]
              }
            },
            "updatedAt": { "type": "string" },
            "updatedBy": { "type": "string" }
          }
        }
      }
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/bookings" },
      "description": "Ad-hoc room bookings"
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/rooms" },
      "description": "Room and facility catalog"
    },
    "/schedule/{scheduleId}": {
      "schema": { "$ref": "#/entities/schedule" },
      "description": "Official weekly academic schedule slots"
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/blocks" },
      "description": "Institutional event and exam room blocks"
    },
    "/staff_users/{staffId}": {
      "schema": { "$ref": "#/entities/staff_users" },
      "description": "Public staff operational directory"
    },
    "/metadata/{metaId}": {
      "schema": { "$ref": "#/entities/metadata" },
      "description": "Platform metadata and academic schedule exemptions"
    }
  }
}
